# Your Shopify store's myshopify.com domain
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com

# Optional: Storefront API access token.
# Get it from: Shopify Admin -> Settings -> Apps and sales channels ->
# Develop apps -> [your app] -> API credentials -> Storefront API access token
# Leave blank if your shop allows unauthenticated Storefront API access.
VITE_SHOPIFY_TOKEN=
